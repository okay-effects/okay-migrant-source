  "terms": [],
  "rules": [
    "% applying for PESEL UKR: exclusions",
    "excluded(other_permit) :- applicant_has_other_permit(S).",
    "excluded(other_eu_state) :- applicant_has_other_eu_protection(S).",
    "excluded(protection_application) :- applicant_applied_protection(S).",
    "excluded(border_traffic) :- applicant_border_traffic(S).",
    "blocked(yes) :- excluded(R).",
    "% applying: conditions (passport, 30 days from crossing, eligible group)",
    "verdict(needs_passport) :- applicant_passport(S, no).",
    "late(yes) :- days_since_crossing(S, N), 30 < N.",
    "verdict(too_late_30_days) :- late(yes).",
    "verdict(not_entitled) :- applicant_group(S, none).",
    "verdict(may_get_pesel_ukr) :- applicant_group(S, G), G != none, applicant_passport(P, yes), days_since_crossing(T, N), not late(yes), not blocked(yes).",
    "% holding the UKR status: ways to lose it",
    "lost(left_over_30_days) :- days_away(S, N), 30 < N.",
    "lost(protection_application) :- holder_applied_protection(S).",
    "lost(other_eu_state) :- holder_other_eu_protection(S).",
    "lost(other_permit) :- holder_other_permit(S).",
    "lost(citizenship) :- holder_new_citizenship(S).",
    "lost(no_passport) :- holder_no_passport_shown(S, D).",
    "lost_any(yes) :- lost(R).",
    "verdict(status_kept) :- days_away(S, N), not lost_any(yes).",
    "% ordinary PESEL for a foreigner",
    "verdict(pesel_by_registration) :- registers_residence(S, yes).",
    "verdict(pesel_by_application) :- registers_residence(S, no), law_requires_pesel(T, yes).",
    "verdict(no_basis_for_pesel_yet) :- registers_residence(S, no), law_requires_pesel(T, no)."
  ],
  "answers": [
    {
      "pattern": "excluded_{R:[a-z_]+}",
      "goal": "excluded(R)",
