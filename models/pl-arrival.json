    "% a stay longer than 90 days",
    "below_90(yes) :- stay_more_than(S, N), N < 90.",
    "long(yes) :- stay_more_than(S, N), not below_90(yes).",
    "% the person settles: a long stay, or a national visa (a visa for more than 90 days)",
    "settle(yes) :- long(yes).",
    "settle(yes) :- entry(S, national_visa).",
    "third(yes) :- settle(yes), foreigner(yes).",
    "visa(schengen_visa) :- entry(S, schengen_visa).",
    "visa(national_visa) :- entry(S, national_visa).",
    "short_stay_rule(yes) :- entry(S, schengen_visa).",
    "short_stay_rule(yes) :- entry(S, visa_free).",
    "% Ukrainians fleeing the war (status UKR)",
    "advice(s1_pesel_ukr_in_30_days) :- ukr(yes).",
    "advice(s2_ukr_work_without_permit) :- ukr(yes).",
    "advice(s3_ukr_away_at_most_30_days) :- ukr(yes).",
    "advice(s4_ukr_cukr_after_365_days) :- ukr(yes).",
    "% EU, EEA and Swiss citizens",
    "advice(s1_eu_three_months_free) :- eu(yes).",
    "advice(s2_eu_register_stay) :- eu(yes), long(yes).",
    "advice(s3_eu_work_free) :- eu(yes).",
    "% registration of residence and PESEL for anyone settling, except status UKR",
    "advice(s9_register_residence_pesel) :- settle(yes), not ukr(yes).",
    "% third-country nationals, any stay",
    "advice(s1_count_90_in_180_days) :- foreigner(yes), short_stay_rule(yes).",
    "advice(s2_work_needs_a_permit) :- foreigner(yes), purpose(S, work).",
    "% third-country nationals settling",
    "advice(s3_apply_while_stay_is_legal) :- third(yes).",
    "advice(s4_single_permit) :- third(yes), purpose(S, work).",
    "advice(s4_spouse_permit) :- third(yes), purpose(S, spouse_of_pole).",
